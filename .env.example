# =============================================================================
# Environment variables for docker-compose
# Copy to .env before running `docker-compose up`:
#     cp .env.example .env
# =============================================================================

# Airflow encrypts connection/variable secrets with this key. It must be a
# valid 32-byte url-safe base64 string - Airflow fails to start otherwise.
# Generate a fresh one with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=5OOim7UfnzxjsOZaCN8lqSDiHfUWXNumavlF0Q3eh_Y=

# Flask session signing key for the Airflow webserver.
# Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=927be5a65b9faa15cc9901cff7b395bfc5771a2a4357964d04f73cb9d1da8d78

# =============================================================================
# Pipeline configuration (used when running locally, outside Docker)
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=movie-rating-prediction
REGISTERED_MODEL_NAME=movie-rating-model

# A retrained model is promoted to Production only when RMSE beats this value.
AIRFLOW_RMSE_THRESHOLD=1.0
