# =============================================================================
# Airflow image with the ML pipeline's dependencies baked in.
# =============================================================================
# The stock apache/airflow image has no scikit-surprise / mlflow, so the DAG's
# `from pipeline...` imports would fail at parse time. Installing them in the
# image (rather than via _PIP_ADDITIONAL_REQUIREMENTS at container start) keeps
# scheduler restarts fast and the environment reproducible.
FROM apache/airflow:2.8.0

# scikit-surprise ships Cython sources and is compiled at install time, which
# needs a toolchain that the slim Airflow image does not carry.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# numpy must be present *before* scikit-surprise builds against it, and
# setuptools must stay < 81 because surprise still imports pkg_resources.
RUN pip install --no-cache-dir "setuptools<81" "numpy==1.26.2" \
    && pip install --no-cache-dir \
        "mlflow==2.9.2" \
        "scikit-surprise==1.1.3" \
        "matplotlib==3.8.2" \
        "pandas==2.1.3"
